---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { t, tArr, buildWhatsAppUrl } from '../../utils/i18n';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import imgPilling1 from '../../assets/images/pilling1.jpeg';
import imgEsfumer from '../../assets/images/esfumer.jpeg';
import img65 from '../../assets/images/65.jpeg';

const lang = 'en' as const;
const waUrl = buildWhatsAppUrl(lang, 'galvanizing');

const steps = [
  {
    n: 1,
    title: t(lang, 'galv_page.step1_title'),
    desc: t(lang, 'galv_page.step1_desc'),
    icon: 'M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1M9 12a3 3 0 1 0 6 0 3 3 0 0 0-6 0Z',
  },
  {
    n: 2,
    title: t(lang, 'galv_page.step2_title'),
    desc: t(lang, 'galv_page.step2_desc'),
    icon: 'M8 3h8M9 3v5L4.5 19a1.5 1.5 0 0 0 1.4 2h12.2a1.5 1.5 0 0 0 1.4-2L15 8V3M7 14h10',
  },
  {
    n: 3,
    title: t(lang, 'galv_page.step3_title'),
    desc: t(lang, 'galv_page.step3_desc'),
    icon: 'M12 3c0 0-6 7-6 11a6 6 0 0 0 12 0c0-4-6-11-6-11Z',
  },
  {
    n: 4,
    title: t(lang, 'galv_page.step4_title'),
    desc: t(lang, 'galv_page.step4_desc'),
    icon: 'M12 2c-2 5-5 8-5 13a5 5 0 0 0 10 0c0-5-3-8-5-13ZM10 17a2 2 0 0 0 4 0c0-2-2-4-2-4s-2 2-2 4Z',
  },
  {
    n: 5,
    title: t(lang, 'galv_page.step5_title'),
    desc: t(lang, 'galv_page.step5_desc'),
    icon: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM8 12l3 3 5-6',
  },
];

const sectors = [
  t(lang, 'galv_page.sector_1'),
  t(lang, 'galv_page.sector_2'),
  t(lang, 'galv_page.sector_3'),
  t(lang, 'galv_page.sector_4'),
];

const sectorStats = [
  { value: t(lang, 'galv_page.sectors_stat_1_value'), label: t(lang, 'galv_page.sectors_stat_1_label') },
  { value: t(lang, 'galv_page.sectors_stat_2_value'), label: t(lang, 'galv_page.sectors_stat_2_label') },
  { value: t(lang, 'galv_page.sectors_stat_3_value'), label: t(lang, 'galv_page.sectors_stat_3_label') },
];

const heroLabels = tArr(lang, 'galv_page.cta_hero_labels');
const midLabels = tArr(lang, 'galv_page.cta_mid_labels');
const finalLabels = tArr(lang, 'galv_page.cta_final_labels');
---

<BaseLayout
  title="PYGLARA | Hot-Dip Galvanizing Services | Barquisimeto, Venezuela"
  description="Industrial hot-dip galvanizing. 50+ years projected service life. COVENIN 1212-81 and ASTM A123 certification on every delivery. Pilling kettles up to 9m. Barquisimeto, Venezuela."
  lang={lang}
  activePage="galvanizing"
  altSlug="galvanizacion"
>
  <meta slot="head" property="og:title" content="PYGLARA | Hot-Dip Galvanizing Services | Barquisimeto, Venezuela" />
  <meta slot="head" property="og:description" content="Your steel lasts 50 years, or it rusts. Industrial hot-dip galvanizing with per-lot certification. Pilling kettles up to 9m. Barquisimeto, Venezuela." />
  <meta slot="head" property="og:image" content="https://pyglara.com/images/og-homepage.jpg" />
  <meta slot="head" property="og:url" content="https://pyglara.com/en/galvanizing/" />
  <meta slot="head" property="og:type" content="website" />
  <meta slot="head" property="og:locale" content="en_US" />

  <!-- Hero hook -->
  <section class="relative bg-navy" style="min-height: 70svh; overflow: clip;">
    <Image
      src={imgPilling1}
      alt={t(lang, 'galv_page.photo_alt_1')}
      width={1440} height={810} quality={70}
      loading="eager" fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
      style="opacity: 0.22;"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(10,22,40,0.65) 0%, rgba(10,22,40,0.82) 60%, rgba(10,22,40,0.98) 100%);"></div>

    <div class="relative z-10 flex flex-col justify-center px-6 md:px-16 py-20 max-w-4xl" style="min-height: 70svh;">
      <h1 class="font-black uppercase leading-none mb-6" style="font-size: clamp(2.4rem, 7vw, 5.5rem); font-family: 'Arial Black', 'Arial Bold', Arial, sans-serif; letter-spacing: -0.02em;">
        <span class="block text-white">{t(lang, 'galv_page.hero_line1')}</span>
        <span class="block text-copper">{t(lang, 'galv_page.hero_line2')}</span>
      </h1>
      <p class="text-white/55 text-base md:text-lg leading-relaxed mb-3 max-w-lg">
        {t(lang, 'galv_page.hero_sub')}
      </p>
      <p class="text-white/35 text-xs tracking-widest uppercase mb-8">
        {t(lang, 'galv_page.hero_kettle_status')}
      </p>
      <div class="max-w-xs">
        <WhatsAppButton href={waUrl} variant="inline" labels={heroLabels} label={t(lang, 'galv_page.cta_mid_label')} />
      </div>
    </div>
  </section>

  <!-- Copper divider -->
  <div class="bg-copper" style="height: 3px;"></div>

  <!-- Problem -->
  <section class="bg-navy py-16 fade-up">
    <div class="max-w-content mx-auto px-4" style="max-width: 52rem;">
      <h2 class="text-white font-bold leading-snug mb-5" style="font-size: clamp(1.4rem, 3vw, 2rem);">
        {t(lang, 'galv_page.problem_heading')}
      </h2>
      <p class="text-white/65 text-base md:text-lg leading-relaxed">
        {t(lang, 'galv_page.problem_body')}
      </p>
    </div>
  </section>

  <!-- Solution + stats -->
  <section class="bg-bg py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <div class="mb-12" style="max-width: 52rem;">
        <h2 class="text-navy font-bold leading-snug mb-5" style="font-size: clamp(1.4rem, 3vw, 2rem);">
          {t(lang, 'galv_page.solution_heading')}
        </h2>
        <p class="text-text/70 text-base leading-relaxed">
          {t(lang, 'galv_page.solution_body')}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { value: t(lang, 'galv_page.stat_years_value'),  label: t(lang, 'galv_page.stat_years_label') },
          { value: t(lang, 'galv_page.stat_kettle_value'), label: t(lang, 'galv_page.stat_kettle_label') },
          { value: t(lang, 'galv_page.stat_zinc_value'),   label: t(lang, 'galv_page.stat_zinc_label') },
        ].map(stat => (
          <div class="border-l-4 border-copper pl-5 py-2 fade-up">
            <p class="text-navy font-black mb-1" style="font-size: 2rem;">{stat.value}</p>
            <p class="text-text/60 text-sm leading-snug">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why PYGLARA -->
  <section class="bg-bg-alt py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-10">{t(lang, 'galv_page.why_heading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {[
          { title: t(lang, 'galv_page.why_1_title'), body: t(lang, 'galv_page.why_1_body') },
          { title: t(lang, 'galv_page.why_2_title'), body: t(lang, 'galv_page.why_2_body') },
          { title: t(lang, 'galv_page.why_3_title'), body: t(lang, 'galv_page.why_3_body') },
          { title: t(lang, 'galv_page.why_4_title'), body: t(lang, 'galv_page.why_4_body') },
        ].map(item => (
          <div class="flex gap-4 items-start fade-up">
            <span class="flex-shrink-0 rounded-full bg-copper" style="width:10px;height:10px;margin-top:6px;"></span>
            <div>
              <p class="font-bold text-navy mb-2">{item.title}</p>
              <p class="text-text/70 text-sm leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sectors served -->
  <section class="bg-bg py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-3">{t(lang, 'galv_page.sectors_heading')}</h2>
      <p class="text-text/55 text-base mb-10">{t(lang, 'galv_page.sectors_intro')}</p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
        {sectors.map(s => (
          <div class="border border-copper/40 rounded px-4 py-4 text-center fade-up" style="background: rgba(184,115,51,0.04);">
            <p class="text-navy text-sm font-bold leading-snug">{s}</p>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-6 border-t border-navy/10">
        {sectorStats.map(stat => (
          <div class="fade-up">
            <p class="text-copper font-black mb-1" style="font-size: 1.75rem;">{stat.value}</p>
            <p class="text-text/65 text-sm leading-snug">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we galvanize -->
  <section class="bg-bg-alt py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-3">{t(lang, 'galv_page.products_heading')}</h2>
      <p class="text-text/55 text-base mb-10">{t(lang, 'galv_page.products_intro')}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
        {[
          t(lang, 'galv_page.product_1'),
          t(lang, 'galv_page.product_2'),
          t(lang, 'galv_page.product_3'),
          t(lang, 'galv_page.product_4'),
          t(lang, 'galv_page.product_5'),
          t(lang, 'galv_page.product_6'),
          t(lang, 'galv_page.product_7'),
          t(lang, 'galv_page.product_8'),
        ].map(product => (
          <div class="border border-navy/15 rounded px-4 py-3 fade-up" style="background: white;">
            <p class="text-navy text-sm font-medium leading-snug">{product}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mid CTA -->
  <section class="bg-navy py-14 fade-up">
    <div class="max-w-content mx-auto px-4" style="max-width: 52rem;">
      <h2 class="text-white text-2xl font-bold mb-3">{t(lang, 'galv_page.cta_mid_heading')}</h2>
      <p class="text-white/60 text-base mb-7">{t(lang, 'galv_page.cta_mid_body')}</p>
      <div class="max-w-xs">
        <WhatsAppButton href={waUrl} variant="inline" labels={midLabels} label={t(lang, 'galv_page.cta_mid_label')} />
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-bg py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-3">{t(lang, 'galv_page.process_heading')}</h2>
      <p class="text-text/55 text-sm mb-10">{t(lang, 'galv_page.process_intro')}</p>
      <ol class="space-y-6" style="max-width: 52rem;">
        {steps.map(step => (
          <li class="flex gap-5 items-start fade-up">
            <div class="flex-shrink-0 flex items-center gap-3" style="min-width: 4.5rem;">
              <span class="text-copper font-black text-2xl" style="line-height: 1.4;">{step.n}.</span>
              <span class="rounded-full flex items-center justify-center" style="width: 38px; height: 38px; background: rgba(184,115,51,0.10);">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#b87333" stroke-width="1.6" aria-hidden="true">
                  <path d={step.icon} stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
            <div>
              <p class="font-bold text-navy mb-1">{step.title}</p>
              <p class="text-text/70 text-sm leading-relaxed">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Kettle specs -->
  <section class="bg-bg-alt py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-3">{t(lang, 'galv_page.kettles_heading')}</h2>
      <p class="text-text/55 text-sm mb-6">{t(lang, 'galv_page.kettles_caption')}</p>
      <div style="overflow-x: auto;">
        <table
          aria-label={t(lang, 'galv_page.table_aria_label')}
          class="w-full text-sm text-left border-collapse"
        >
          <thead>
            <tr class="border-b-2 border-navy">
              <th class="py-3 pr-4 font-semibold text-navy">{t(lang, 'galv_page.col_kettle')}</th>
              <th class="py-3 pr-4 font-semibold text-navy">{t(lang, 'galv_page.col_dimensions')}</th>
              <th class="py-3 pr-4 font-semibold text-navy">{t(lang, 'galv_page.col_max_piece')}</th>
              <th class="py-3 font-semibold text-navy">{t(lang, 'galv_page.col_status')}</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="py-3 pr-4 font-medium text-text">{t(lang, 'galv_page.centrifuge_name')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.centrifuge_dims')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.centrifuge_max')}</td>
              <td class="py-3 font-semibold text-green text-xs">{t(lang, 'galv_page.status_active')}</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-3 pr-4 font-medium text-text">{t(lang, 'galv_page.kettle_7m_name')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.kettle_7m_dims')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.kettle_7m_max')}</td>
              <td class="py-3 text-text/70 text-xs">{t(lang, 'galv_page.status_q2_2026')}</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-medium text-text">{t(lang, 'galv_page.kettle_9m_name')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.kettle_9m_dims')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.kettle_9m_max')}</td>
              <td class="py-3 text-text/70 text-xs">{t(lang, 'galv_page.status_2027')}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 9m kettle callout -->
  <section class="bg-navy py-10 fade-up">
    <div class="max-w-content mx-auto px-4" style="max-width: 52rem;">
      <p class="text-white font-bold text-lg leading-snug">{t(lang, 'galv_page.kettle_9m_callout')}</p>
    </div>
  </section>

  <!-- Quality standards -->
  <section class="bg-bg py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-6">{t(lang, 'galv_page.quality_heading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        {[t(lang, 'galv_page.quality_std_1'), t(lang, 'galv_page.quality_std_2'), t(lang, 'galv_page.quality_std_3')].map(std => (
          <div class="border border-navy/20 rounded px-5 py-4">
            <p class="font-bold text-navy text-sm">{std}</p>
          </div>
        ))}
      </div>
      <p class="text-text/75 text-sm leading-relaxed max-w-2xl">{t(lang, 'galv_page.quality_body')}</p>
    </div>
  </section>

  <!-- HSE commitment -->
  <section class="bg-bg-alt py-12 fade-up">
    <div class="max-w-content mx-auto px-4" style="max-width: 52rem;">
      <h2 class="text-xl font-bold text-navy mb-4">{t(lang, 'galv_page.hse_heading')}</h2>
      <p class="text-text/70 text-sm leading-relaxed">{t(lang, 'galv_page.hse_body')}</p>
    </div>
  </section>

  <!-- Facility photos -->
  <section class="bg-bg-alt py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-6">{t(lang, 'galv_page.photos_heading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Image
          src={img65}
          alt={t(lang, 'galv_page.photo_alt_65')}
          width={480} height={320}
          loading="lazy" quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 260px;"
        />
        <Image
          src={imgEsfumer}
          alt={t(lang, 'galv_page.photo_alt_2')}
          width={480} height={320}
          loading="lazy" quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 260px;"
        />
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-navy py-16 fade-up">
    <div class="max-w-content mx-auto px-4 text-center">
      <h2 class="text-white font-bold mb-4" style="font-size: clamp(1.5rem, 3vw, 2.2rem);">
        {t(lang, 'galv_page.cta_final_heading')}
      </h2>
      <p class="text-white/60 text-base mb-8 max-w-lg mx-auto">{t(lang, 'galv_page.cta_final_body')}</p>
      <div class="flex justify-center">
        <div class="w-full max-w-xs">
          <WhatsAppButton href={waUrl} variant="inline" labels={finalLabels} label={t(lang, 'galv_page.cta_final_label')} />
        </div>
      </div>
      <p class="text-white/45 text-sm mt-6">{t(lang, 'galv_page.contact_fallback')}</p>
    </div>
  </section>

</BaseLayout>
