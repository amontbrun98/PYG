---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { t, buildWhatsAppUrl } from '../../utils/i18n';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import imgPilling1 from '../../assets/images/pilling1.jpeg';
import imgEsfumer from '../../assets/images/esfumer.jpeg';

const lang = 'en' as const;
const waUrl = buildWhatsAppUrl(lang, 'galvanizing');
---

<BaseLayout
  title="PYGLARA — Hot-Dip Galvanizing Services | Barquisimeto, Venezuela"
  description="Hot-dip galvanizing with kettles up to 9m. Zinc SHG 99.99% purity. COVENIN 1212-81 and ASTM A123 certification on every delivery. Largest capacity in western Venezuela."
  lang={lang}
  activePage="galvanizing"
  altSlug="galvanizacion"
>
  <!-- Open Graph meta tags for EN -->
  <meta slot="head" property="og:title" content="PYGLARA — Hot-Dip Galvanizing Services | Barquisimeto, Venezuela" />
  <meta slot="head" property="og:description" content="Galvanizing kettles up to 9m long. No other active Venezuelan galvanizer can process workpieces above 7m. Per-lot certification on every delivery." />
  <meta slot="head" property="og:image" content="https://pyglara.com/images/og-homepage.jpg" />
  <meta slot="head" property="og:url" content="https://pyglara.com/en/galvanizing/" />
  <meta slot="head" property="og:type" content="website" />
  <meta slot="head" property="og:locale" content="en_US" />

  <!-- Hero -->
  <section class="relative bg-navy" style="min-height: 65svh; overflow: clip;">
    <Image
      src={imgPilling1}
      alt={t(lang, 'galv_page.photo_alt_1')}
      width={1440} height={810} quality={70}
      loading="eager" fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
      style="opacity: 0.35;"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(10,22,40,0.50) 0%, rgba(10,22,40,0.70) 50%, rgba(10,22,40,0.95) 100%);"></div>

    <div class="relative z-10 flex flex-col justify-center px-6 md:px-16 py-20 max-w-4xl" style="min-height: 65svh;">
      <p class="text-copper text-xs font-bold uppercase tracking-widest mb-4">{t(lang, 'galv_page.hero_tag')}</p>
      <h1 class="text-white font-black uppercase leading-none mb-5" style="font-size: clamp(2.2rem, 7vw, 5rem); font-family: 'Arial Black', 'Arial Bold', Arial, sans-serif; letter-spacing: -0.01em;">
        {t(lang, 'galv_page.hero_heading')}
      </h1>
      <p class="text-white/75 text-base md:text-lg leading-relaxed mb-7 max-w-xl">
        {t(lang, 'galv_page.hero_sub')}
      </p>
      <div class="max-w-xs">
        <WhatsAppButton href={waUrl} variant="inline" label={t(lang, 'galv_page.cta_mid_label')} />
      </div>
    </div>
  </section>

  <!-- Copper divider -->
  <div class="bg-copper" style="height: 3px;"></div>

  <!-- Kettle specs table -->
  <section class="bg-bg py-14 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-2">{t(lang, 'galv_page.kettles_heading')}</h2>
      <p class="text-text/60 text-sm mb-6">{t(lang, 'galv_page.kettles_caption')}</p>
      <div style="overflow-x: auto;">
        <table
          aria-label={t(lang, 'galv_page.table_aria_label')}
          class="w-full text-sm text-left border-collapse"
        >
          <thead>
            <tr class="border-b-2 border-navy">
              <th class="py-3 pr-4 font-semibold text-navy">{t(lang, 'galv_page.col_kettle')}</th>
              <th class="py-3 pr-4 font-semibold text-navy">{t(lang, 'galv_page.col_dimensions')}</th>
              <th class="py-3 pr-4 font-semibold text-navy">{t(lang, 'galv_page.col_max_piece')}</th>
              <th class="py-3 font-semibold text-navy">{t(lang, 'galv_page.col_status')}</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="py-3 pr-4 font-medium text-text">{t(lang, 'galv_page.centrifuge_name')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.centrifuge_dims')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.centrifuge_max')}</td>
              <td class="py-3">
                <span class="inline-block px-2 py-0.5 text-xs font-bold rounded" style="background: #dcfce7; color: #166534;">
                  {t(lang, 'galv_page.status_active')}
                </span>
              </td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-3 pr-4 font-medium text-text">{t(lang, 'galv_page.kettle_7m_name')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.kettle_7m_dims')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.kettle_7m_max')}</td>
              <td class="py-3">
                <span class="inline-block px-2 py-0.5 text-xs font-bold rounded text-copper" style="background: #fef3e2;">
                  {t(lang, 'galv_page.status_q2_2026')}
                </span>
              </td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-medium text-text">{t(lang, 'galv_page.kettle_9m_name')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.kettle_9m_dims')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.kettle_9m_max')}</td>
              <td class="py-3">
                <span class="inline-block px-2 py-0.5 text-xs font-bold rounded text-navy" style="background: #e0e7ef;">
                  {t(lang, 'galv_page.status_2027')}
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- 9m callout block — immediately beneath table -->
      <div class="mt-6 bg-navy text-white rounded px-6 py-5 fade-up">
        <p class="text-copper text-xs font-bold uppercase tracking-widest mb-2">{t(lang, 'galv_page.callout_label')}</p>
        <p class="text-white text-base font-semibold leading-snug">{t(lang, 'galv_page.kettle_9m_callout')}</p>
      </div>
    </div>
  </section>

  <!-- Mid-page WhatsApp CTA -->
  <section class="bg-bg-alt py-10 fade-up">
    <div class="max-w-content mx-auto px-4 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <p class="text-navy font-semibold text-lg flex-1">{t(lang, 'galv_page.cta_mid_text')}</p>
      <div class="flex-shrink-0">
        <WhatsAppButton href={waUrl} variant="inline" label={t(lang, 'galv_page.cta_mid_label')} />
      </div>
    </div>
  </section>

  <!-- Process steps -->
  <section class="bg-bg py-14 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-8">{t(lang, 'galv_page.process_heading')}</h2>
      <ol class="space-y-6">
        {[
          { n: 1, title: t(lang, 'galv_page.step1_title'), desc: t(lang, 'galv_page.step1_desc') },
          { n: 2, title: t(lang, 'galv_page.step2_title'), desc: t(lang, 'galv_page.step2_desc') },
          { n: 3, title: t(lang, 'galv_page.step3_title'), desc: t(lang, 'galv_page.step3_desc') },
          { n: 4, title: t(lang, 'galv_page.step4_title'), desc: t(lang, 'galv_page.step4_desc') },
          { n: 5, title: t(lang, 'galv_page.step5_title'), desc: t(lang, 'galv_page.step5_desc') },
        ].map(step => (
          <li class="flex gap-5 items-start">
            <span class="flex-shrink-0 text-copper font-black text-2xl" style="min-width: 2rem; line-height: 1.4;">{step.n}.</span>
            <div>
              <p class="font-bold text-navy mb-1">{step.title}</p>
              <p class="text-text/70 text-sm leading-relaxed">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Quality standards -->
  <section class="bg-bg-alt py-14 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-6">{t(lang, 'galv_page.quality_heading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        {[t(lang, 'galv_page.quality_std_1'), t(lang, 'galv_page.quality_std_2'), t(lang, 'galv_page.quality_std_3')].map(std => (
          <div class="border border-navy/20 rounded px-5 py-4">
            <p class="font-bold text-navy text-sm">{std}</p>
          </div>
        ))}
      </div>
      <p class="text-text/80 text-sm leading-relaxed max-w-2xl">{t(lang, 'galv_page.quality_body')}</p>
    </div>
  </section>

  <!-- Equipment manufacturer -->
  <section class="bg-bg py-14 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-4">{t(lang, 'galv_page.manufacturer_heading')}</h2>
      <p class="text-text/80 text-sm leading-relaxed max-w-2xl">{t(lang, 'galv_page.manufacturer_body')}</p>
    </div>
  </section>

  <!-- HSE commitment -->
  <section class="bg-bg-alt py-14 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-4">{t(lang, 'galv_page.hse_heading')}</h2>
      <p class="text-text/80 text-sm leading-relaxed max-w-2xl">{t(lang, 'galv_page.hse_body')}</p>
    </div>
  </section>

  <!-- Facility photos -->
  <section class="bg-bg py-14 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-6">{t(lang, 'galv_page.photos_heading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Image
          src={imgPilling1}
          alt={t(lang, 'galv_page.photo_alt_1')}
          width={480} height={320}
          loading="lazy" quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 260px;"
        />
        <Image
          src={imgEsfumer}
          alt={t(lang, 'galv_page.photo_alt_2')}
          width={480} height={320}
          loading="lazy" quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 260px;"
        />
      </div>
    </div>
  </section>

  <!-- Final WhatsApp CTA -->
  <section class="bg-navy py-14 fade-up">
    <div class="max-w-content mx-auto px-4 text-center">
      <h2 class="text-white text-2xl font-bold mb-4">{t(lang, 'galv_page.cta_final_heading')}</h2>
      <p class="text-white/70 text-sm mb-7 max-w-lg mx-auto">{t(lang, 'galv_page.cta_final_body')}</p>
      <div class="flex justify-center">
        <WhatsAppButton href={waUrl} variant="inline" label={t(lang, 'galv_page.cta_final_label')} />
      </div>
    </div>
  </section>

</BaseLayout>
