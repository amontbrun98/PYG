---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { t, buildWhatsAppUrl } from '../../utils/i18n';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import imgEsfumer from '../../assets/images/esfumer.jpeg';
import imgPilling1 from '../../assets/images/pilling1.jpeg';
import imgPlantClean from '../../assets/images/plant-clean.jpeg';
import img65 from '../../assets/images/65.jpeg';
import imgPlantExterior from '../../assets/images/plant-exterior.jpeg';
import imgBrackets from '../../assets/images/brackets.jpeg';
import imgNails from '../../assets/images/nails.jpeg';
import imgNails2 from '../../assets/images/nails2.jpeg';

const lang = 'en' as const;
---

<BaseLayout
  title="PYGLARA — Hot-Dip Galvanizing & Copper Ground Rods | Barquisimeto, Venezuela"
  description="Venezuela's only dual-capability industrial galvanizer. Hot-dip galvanizing up to 9m and copper-clad ground rods. Serving electrical, telecom, and construction sectors since 1976."
  lang={lang}
  activePage="home"
  ogImage="https://pyglara.com/images/og-homepage.jpg"
>
  <!-- Open Graph meta tags for EN — critical for LinkedIn/Slack unfurl -->
  <meta slot="head" property="og:title" content="PYGLARA — Hot-Dip Galvanizing & Copper Ground Rods | Barquisimeto, Venezuela" />
  <meta slot="head" property="og:description" content="Venezuela's only dual-capability industrial galvanizer. Hot-dip galvanizing up to 9m and copper-clad ground rods. Serving electrical, telecom, and construction sectors since 1976." />
  <meta slot="head" property="og:image" content="https://pyglara.com/images/og-homepage.jpg" />
  <meta slot="head" property="og:url" content="https://pyglara.com/en/" />
  <meta slot="head" property="og:type" content="website" />
  <meta slot="head" property="og:locale" content="en_US" />

  <style>
    @keyframes hero-slam-up {
      0%   { opacity: 0; transform: translateY(40px); }
      60%  { opacity: 1; transform: translateY(-4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes hero-slam-left {
      0%   { opacity: 0; transform: translateX(32px); }
      60%  { opacity: 1; transform: translateX(-3px); }
      100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes hero-copper-bar {
      from { height: 0; }
      to   { height: 100%; }
    }
    @keyframes hero-fade-in {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    .hero-copper-bar {
      position: absolute; left: 0; top: 0;
      width: 5px; height: 0;
      background: linear-gradient(to bottom, #A8B4BE, #6B7E8A, #8B9BA8);
      animation: hero-copper-bar 0.6s ease 0.1s forwards;
    }
    .hero-tag {
      font-family: 'Arial Narrow', Arial, sans-serif;
      font-weight: 900; text-transform: uppercase;
      letter-spacing: 0.25em; font-size: 0.65rem;
      opacity: 0; animation: hero-fade-in 0.4s ease 0.1s forwards;
    }
    .hero-h1 {
      font-family: 'Arial Black', 'Arial Bold', Arial, sans-serif;
      font-weight: 900; text-transform: uppercase;
      line-height: 0.92; letter-spacing: -0.01em;
    }
    .hero-line-1 { display: block; opacity: 0; animation: hero-slam-up 0.55s cubic-bezier(0.22,1,0.36,1) 0.3s forwards; }
    .hero-line-2 {
      display: block;
      background: linear-gradient(
        105deg,
        #8B9199 0%,
        #C4C9CF 20%,
        #EAECEE 38%,
        #D0D4D8 50%,
        #9BA3AB 70%,
        #BFC4CA 100%
      );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
      opacity: 0;
      animation: hero-slam-up 0.55s cubic-bezier(0.22,1,0.36,1) 0.52s forwards;
    }
    .hero-line-3 { display: block; opacity: 0; animation: hero-slam-up 0.55s cubic-bezier(0.22,1,0.36,1) 0.72s forwards; }
    .hero-co-name {
      font-family: 'Arial Narrow', Arial, sans-serif;
      font-weight: 400; font-style: normal;
      letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.7rem;
      opacity: 0; animation: hero-fade-in 0.5s ease 1.1s forwards;
    }
    .hero-sub { opacity: 0; animation: hero-slam-left 0.5s cubic-bezier(0.22,1,0.36,1) 1.0s forwards; }
    .hero-b1  { opacity: 0; animation: hero-fade-in 0.4s ease 1.25s forwards; }
    .hero-b2  { opacity: 0; animation: hero-fade-in 0.4s ease 1.45s forwards; }
    .hero-b3  { opacity: 0; animation: hero-fade-in 0.4s ease 1.65s forwards; }
    .hero-cta { opacity: 0; animation: hero-slam-up 0.5s cubic-bezier(0.22,1,0.36,1) 1.85s forwards; }
  </style>

  <!-- Hero — Option B Impact -->
  <section class="relative bg-navy overflow-hidden" style="min-height: 100svh;">
    <Image
      src={imgEsfumer}
      alt="7m galvanizing kettle enclosure — PYGLARA plant, Barquisimeto"
      width={1440} height={810} quality={70}
      loading="eager" fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
      style="opacity: 0.38;"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(10,22,40,0.55) 0%, rgba(10,22,40,0.75) 50%, rgba(10,22,40,0.97) 100%);"></div>
    <div class="hero-copper-bar"></div>

    <div class="relative z-10 flex flex-col justify-center px-8 md:px-16 py-24 max-w-4xl" style="min-height: 100svh;">
      <p class="hero-tag text-copper mb-6">Barquisimeto · Since 1976</p>

      <h1 class="hero-h1 text-white mb-6" style="font-size: clamp(2.8rem, 9vw, 7rem);">
        <span class="hero-line-1">Your steel.</span>
        <span class="hero-line-2">Galvanized.</span>
        <span class="hero-line-3">Guaranteed.</span>
      </h1>

      <p class="hero-co-name text-white/50 mb-6 tracking-widest">
        Prensados y Galvanizados de Lara, S.A.
      </p>

      <p class="hero-sub text-white/70 text-base md:text-lg leading-relaxed mb-7 max-w-lg">
        The largest capacity in western Venezuela. Kettles up to 9m. COVENIN + ASTM certified on every delivery.
      </p>

      <ul class="space-y-2 mb-8">
        <li class="hero-b1 flex items-center gap-3 text-white text-sm font-bold uppercase tracking-wide">
          <span style="width:3px;height:20px;background:#8B9BA8;display:inline-block;flex-shrink:0;"></span>
          300 MT/month · Kettles up to 9m
        </li>
        <li class="hero-b2 flex items-center gap-3 text-white text-sm font-bold uppercase tracking-wide">
          <span style="width:3px;height:20px;background:#8B9BA8;display:inline-block;flex-shrink:0;"></span>
          Zinc SHG 99.99% · Pilling equipment (Germany)
        </li>
        <li class="hero-b3 flex items-center gap-3 text-white text-sm font-bold uppercase tracking-wide">
          <span style="width:3px;height:20px;background:#8B9BA8;display:inline-block;flex-shrink:0;"></span>
          936 copper rods/day
        </li>
      </ul>

      <div class="hero-cta max-w-xs">
        <WhatsAppButton
          href={buildWhatsAppUrl(lang, 'galvanizing')}
          variant="inline"
          label={t(lang, 'hero.cta_whatsapp')}
        />
      </div>
    </div>
  </section>

  <!-- Copper divider -->
  <div class="bg-copper" style="height: 3px;"></div>

  <!-- Section 3: Stats bar -->
  <section class="bg-navy py-14">
    <div class="max-w-content mx-auto px-4">
      <p class="text-center text-white/40 text-xs uppercase tracking-widest mb-10 fade-up">{t(lang, 'stats.context')}</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div class="fade-up">
          <div class="text-5xl font-bold text-white">
            <span class="stat-number" data-target="300">0</span>
          </div>
          <div class="text-copper text-xs mt-2 leading-snug">{t(lang, 'stats.capacity_label')}</div>
        </div>
        <div class="fade-up">
          <div class="text-5xl font-bold text-white">
            <span class="stat-number" data-target="936">0</span>
          </div>
          <div class="text-copper text-xs mt-2 leading-snug">{t(lang, 'stats.rods_label')}</div>
        </div>
        <div class="fade-up">
          <div class="text-5xl font-bold text-white">
            <span class="stat-number" data-target="50">0</span><span class="text-white">+</span>
          </div>
          <div class="text-copper text-xs mt-2 leading-snug">{t(lang, 'stats.years_label')}</div>
        </div>
        <div class="fade-up">
          <div class="text-5xl font-bold text-white">
            <span class="stat-number" data-target="2">0</span>
          </div>
          <div class="text-copper text-xs mt-2 leading-snug">{t(lang, 'stats.competitors_label')}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Trust / Why PYGLARA -->
  <section class="bg-bg py-16">
    <div class="max-w-content mx-auto px-4">
      <div class="mb-10 fade-up">
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-3">{t(lang, 'trust.heading')}</h2>
        <p class="text-text/70 text-lg max-w-2xl">{t(lang, 'trust.intro')}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { title: t(lang, 'trust.bullet1_title'), body: t(lang, 'trust.bullet1_body') },
          { title: t(lang, 'trust.bullet2_title'), body: t(lang, 'trust.bullet2_body') },
          { title: t(lang, 'trust.bullet3_title'), body: t(lang, 'trust.bullet3_body') },
          { title: t(lang, 'trust.bullet4_title'), body: t(lang, 'trust.bullet4_body') },
          { title: t(lang, 'trust.bullet5_title'), body: t(lang, 'trust.bullet5_body') },
          { title: t(lang, 'trust.bullet6_title'), body: t(lang, 'trust.bullet6_body') },
        ].map(item => (
          <div class="flex gap-4 fade-up">
            <span class="flex-shrink-0 rounded-full bg-copper" style="width:10px;height:10px;margin-top:6px;"></span>
            <div>
              <p class="font-semibold text-navy text-sm mb-1">{item.title}</p>
              <p class="text-text/70 text-sm leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5: Dual capability cards -->
  <section class="bg-bg-alt py-14">
    <div class="max-w-content mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Galvanizing card — Pilling kettle as bg -->
      <div class="relative bg-navy text-white rounded overflow-hidden fade-up">
        <!-- TODO Story 7-2: add href to service page -->
        <Image
          src={imgPilling1}
          alt="W. Pilling Riepe GmbH galvanizing kettle — PYGLARA"
          width={480}
          height={320}
          loading="lazy"
          quality={70}
          class="absolute inset-0 w-full h-full object-cover"
          style="opacity: 0.20;"
        />
        <div class="relative z-10 p-6">
          <h2 class="text-xl font-bold mb-4">{t(lang, 'cards.galvanizing_title')}</h2>
          <ul class="space-y-2 text-white/80 text-sm mb-6">
            <li>&#x2713; {t(lang, 'cards.galvanizing_bullet1')}</li>
            <li>&#x2713; {t(lang, 'cards.galvanizing_bullet2')}</li>
            <li>&#x2713; {t(lang, 'cards.galvanizing_bullet3')}</li>
          </ul>
          <WhatsAppButton
            href={buildWhatsAppUrl(lang, 'galvanizing')}
            variant="inline"
            label={t(lang, 'hero.cta_whatsapp')}
          />
        </div>
      </div>

      <!-- Copper card — copper plating line as bg -->
      <div class="relative bg-copper text-white rounded overflow-hidden fade-up">
        <!-- TODO Story 7-3: add href to service page -->
        <Image
          src={imgPlantClean}
          alt="Copper electroplating line — PYGLARA"
          width={480}
          height={320}
          loading="lazy"
          quality={70}
          class="absolute inset-0 w-full h-full object-cover"
          style="opacity: 0.20;"
        />
        <div class="relative z-10 p-6">
          <h2 class="text-xl font-bold mb-4">{t(lang, 'cards.copper_title')}</h2>
          <ul class="space-y-2 text-white/80 text-sm mb-6">
            <li>&#x2713; {t(lang, 'cards.copper_bullet1')}</li>
            <li>&#x2713; {t(lang, 'cards.copper_bullet2')}</li>
            <li>&#x2713; {t(lang, 'cards.copper_bullet3')}</li>
          </ul>
          <WhatsAppButton
            href={buildWhatsAppUrl(lang, 'copper_rods')}
            variant="inline"
            label={t(lang, 'hero.cta_whatsapp')}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 7: Company snapshot / history -->
  <section class="bg-bg-alt py-14">
    <div class="max-w-content mx-auto px-4 fade-up">
      <h2 class="text-2xl font-bold text-navy mb-6">{t(lang, 'snapshot.heading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <p class="text-text leading-relaxed">{t(lang, 'snapshot.body')}</p>
        </div>
        <ul class="space-y-3 text-text text-sm">
          <li class="flex items-start gap-2">
            <span class="text-copper font-bold mt-0.5">&#x2022;</span>
            <span>{t(lang, 'snapshot.equipment')}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-copper font-bold mt-0.5">&#x2022;</span>
            <span>{t(lang, 'snapshot.standards')}</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-copper font-bold mt-0.5">&#x2022;</span>
            <span>{t(lang, 'snapshot.market')}</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Section 6: Facility photos — 6 real photos -->
  <section class="bg-bg-alt py-14">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-6 fade-up">{t(lang, 'facility.heading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <Image
          src={img65}
          alt={t(lang, 'facility.alt1')}
          width={480}
          height={360}
          loading="lazy"
          quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 220px;"
        />
        <Image
          src={imgPlantExterior}
          alt={t(lang, 'facility.alt2')}
          width={480}
          height={360}
          loading="lazy"
          quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 220px;"
        />
        <Image
          src={imgBrackets}
          alt={t(lang, 'facility.alt3')}
          width={480}
          height={360}
          loading="lazy"
          quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 220px;"
        />
        <Image
          src={imgNails}
          alt={t(lang, 'facility.alt4')}
          width={480}
          height={360}
          loading="lazy"
          quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 220px;"
        />
        <Image
          src={imgNails2}
          alt={t(lang, 'facility.alt5')}
          width={480}
          height={360}
          loading="lazy"
          quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 220px;"
        />
        <Image
          src={imgEsfumer}
          alt={t(lang, 'facility.alt6')}
          width={480}
          height={360}
          loading="lazy"
          quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 220px;"
        />
      </div>
    </div>
  </section>
</BaseLayout>
