---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { t, buildWhatsAppUrl } from '../../utils/i18n';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import imgPilling1 from '../../assets/images/pilling1.jpeg';
import imgEsfumer from '../../assets/images/esfumer.jpeg';

const lang = 'es' as const;
const waUrl = buildWhatsAppUrl(lang, 'galvanizing');
---

<BaseLayout
  title="PYGLARA — Galvanización en Caliente | Barquisimeto, Venezuela"
  description="Galvanización industrial en caliente. 50+ años de vida útil proyectada. Certificación COVENIN 1212-81 y ASTM A123 en cada entrega. La mayor capacidad del occidente venezolano."
  lang={lang}
  activePage="galvanizing"
  altSlug="galvanizing"
>

  <!-- Hero — hook -->
  <section class="relative bg-navy" style="min-height: 70svh; overflow: clip;">
    <Image
      src={imgPilling1}
      alt={t(lang, 'galv_page.photo_alt_1')}
      width={1440} height={810} quality={70}
      loading="eager" fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
      style="opacity: 0.22;"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(10,22,40,0.65) 0%, rgba(10,22,40,0.82) 60%, rgba(10,22,40,0.98) 100%);"></div>

    <div class="relative z-10 flex flex-col justify-center px-6 md:px-16 py-20 max-w-4xl" style="min-height: 70svh;">
      <h1 class="font-black uppercase leading-none mb-6" style="font-size: clamp(2.4rem, 7vw, 5.5rem); font-family: 'Arial Black', 'Arial Bold', Arial, sans-serif; letter-spacing: -0.02em;">
        <span class="block text-white">{t(lang, 'galv_page.hero_line1')}</span>
        <span class="block text-copper">{t(lang, 'galv_page.hero_line2')}</span>
      </h1>
      <p class="text-white/55 text-base md:text-lg leading-relaxed mb-8 max-w-lg">
        {t(lang, 'galv_page.hero_sub')}
      </p>
      <div class="max-w-xs">
        <WhatsAppButton href={waUrl} variant="inline" label={t(lang, 'galv_page.cta_mid_label')} />
      </div>
    </div>
  </section>

  <!-- Copper divider -->
  <div class="bg-copper" style="height: 3px;"></div>

  <!-- Problem -->
  <section class="bg-navy py-16 fade-up">
    <div class="max-w-content mx-auto px-4" style="max-width: 52rem;">
      <h2 class="text-white font-bold leading-snug mb-5" style="font-size: clamp(1.4rem, 3vw, 2rem);">
        {t(lang, 'galv_page.problem_heading')}
      </h2>
      <p class="text-white/65 text-base md:text-lg leading-relaxed">
        {t(lang, 'galv_page.problem_body')}
      </p>
    </div>
  </section>

  <!-- Solution + stats -->
  <section class="bg-bg py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <div class="mb-12" style="max-width: 52rem;">
        <h2 class="text-navy font-bold leading-snug mb-5" style="font-size: clamp(1.4rem, 3vw, 2rem);">
          {t(lang, 'galv_page.solution_heading')}
        </h2>
        <p class="text-text/70 text-base leading-relaxed">
          {t(lang, 'galv_page.solution_body')}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { value: t(lang, 'galv_page.stat_years_value'), label: t(lang, 'galv_page.stat_years_label') },
          { value: t(lang, 'galv_page.stat_temp_value'),  label: t(lang, 'galv_page.stat_temp_label') },
          { value: t(lang, 'galv_page.stat_zinc_value'),  label: t(lang, 'galv_page.stat_zinc_label') },
        ].map(stat => (
          <div class="border-l-4 border-copper pl-5 py-2 fade-up">
            <p class="text-navy font-black mb-1" style="font-size: 2rem;">{stat.value}</p>
            <p class="text-text/60 text-sm leading-snug">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why PYGLARA -->
  <section class="bg-bg-alt py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-10">{t(lang, 'galv_page.why_heading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {[
          { title: t(lang, 'galv_page.why_1_title'), body: t(lang, 'galv_page.why_1_body') },
          { title: t(lang, 'galv_page.why_2_title'), body: t(lang, 'galv_page.why_2_body') },
          { title: t(lang, 'galv_page.why_3_title'), body: t(lang, 'galv_page.why_3_body') },
          { title: t(lang, 'galv_page.why_4_title'), body: t(lang, 'galv_page.why_4_body') },
        ].map(item => (
          <div class="flex gap-4 items-start fade-up">
            <span class="flex-shrink-0 rounded-full bg-copper" style="width:10px;height:10px;margin-top:6px;"></span>
            <div>
              <p class="font-bold text-navy mb-2">{item.title}</p>
              <p class="text-text/70 text-sm leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we galvanize -->
  <section class="bg-bg py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-navy mb-3">{t(lang, 'galv_page.products_heading')}</h2>
      <p class="text-text/55 text-base mb-10">{t(lang, 'galv_page.products_intro')}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
        {[
          t(lang, 'galv_page.product_1'),
          t(lang, 'galv_page.product_2'),
          t(lang, 'galv_page.product_3'),
          t(lang, 'galv_page.product_4'),
          t(lang, 'galv_page.product_5'),
          t(lang, 'galv_page.product_6'),
          t(lang, 'galv_page.product_7'),
          t(lang, 'galv_page.product_8'),
        ].map(product => (
          <div class="border border-navy/15 rounded px-4 py-3 fade-up">
            <p class="text-navy text-sm font-medium leading-snug">{product}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mid CTA -->
  <section class="bg-navy py-14 fade-up">
    <div class="max-w-content mx-auto px-4" style="max-width: 52rem;">
      <h2 class="text-white text-2xl font-bold mb-3">{t(lang, 'galv_page.cta_mid_heading')}</h2>
      <p class="text-white/60 text-base mb-7">{t(lang, 'galv_page.cta_mid_body')}</p>
      <div class="max-w-xs">
        <WhatsAppButton href={waUrl} variant="inline" label={t(lang, 'galv_page.cta_mid_label')} />
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-bg-alt py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-3">{t(lang, 'galv_page.process_heading')}</h2>
      <p class="text-text/55 text-sm mb-10">{t(lang, 'galv_page.process_intro')}</p>
      <ol class="space-y-6" style="max-width: 52rem;">
        {[
          { n: 1, title: t(lang, 'galv_page.step1_title'), desc: t(lang, 'galv_page.step1_desc') },
          { n: 2, title: t(lang, 'galv_page.step2_title'), desc: t(lang, 'galv_page.step2_desc') },
          { n: 3, title: t(lang, 'galv_page.step3_title'), desc: t(lang, 'galv_page.step3_desc') },
          { n: 4, title: t(lang, 'galv_page.step4_title'), desc: t(lang, 'galv_page.step4_desc') },
          { n: 5, title: t(lang, 'galv_page.step5_title'), desc: t(lang, 'galv_page.step5_desc') },
        ].map(step => (
          <li class="flex gap-5 items-start fade-up">
            <span class="flex-shrink-0 text-copper font-black text-2xl" style="min-width: 2rem; line-height: 1.4;">{step.n}.</span>
            <div>
              <p class="font-bold text-navy mb-1">{step.title}</p>
              <p class="text-text/70 text-sm leading-relaxed">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Kettle specs -->
  <section class="bg-bg py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-3">{t(lang, 'galv_page.kettles_heading')}</h2>
      <p class="text-text/55 text-sm mb-6">{t(lang, 'galv_page.kettles_caption')}</p>
      <div style="overflow-x: auto;">
        <table
          aria-label={t(lang, 'galv_page.table_aria_label')}
          class="w-full text-sm text-left border-collapse"
        >
          <thead>
            <tr class="border-b-2 border-navy">
              <th class="py-3 pr-4 font-semibold text-navy">{t(lang, 'galv_page.col_kettle')}</th>
              <th class="py-3 pr-4 font-semibold text-navy">{t(lang, 'galv_page.col_dimensions')}</th>
              <th class="py-3 font-semibold text-navy">{t(lang, 'galv_page.col_max_piece')}</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="py-3 pr-4 font-medium text-text">{t(lang, 'galv_page.centrifuge_name')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.centrifuge_dims')}</td>
              <td class="py-3 text-text/70">{t(lang, 'galv_page.centrifuge_max')}</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="py-3 pr-4 font-medium text-text">{t(lang, 'galv_page.kettle_7m_name')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.kettle_7m_dims')}</td>
              <td class="py-3 text-text/70">{t(lang, 'galv_page.kettle_7m_max')}</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 font-medium text-text">{t(lang, 'galv_page.kettle_9m_name')}</td>
              <td class="py-3 pr-4 text-text/70">{t(lang, 'galv_page.kettle_9m_dims')}</td>
              <td class="py-3 text-text/70">{t(lang, 'galv_page.kettle_9m_max')}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Quality standards -->
  <section class="bg-bg-alt py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-6">{t(lang, 'galv_page.quality_heading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        {[t(lang, 'galv_page.quality_std_1'), t(lang, 'galv_page.quality_std_2'), t(lang, 'galv_page.quality_std_3')].map(std => (
          <div class="border border-navy/20 rounded px-5 py-4">
            <p class="font-bold text-navy text-sm">{std}</p>
          </div>
        ))}
      </div>
      <p class="text-text/75 text-sm leading-relaxed max-w-2xl">{t(lang, 'galv_page.quality_body')}</p>
    </div>
  </section>

  <!-- Facility photos -->
  <section class="bg-bg py-16 fade-up">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-navy mb-6">{t(lang, 'galv_page.photos_heading')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Image
          src={imgPilling1}
          alt={t(lang, 'galv_page.photo_alt_1')}
          width={480} height={320}
          loading="lazy" quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 260px;"
        />
        <Image
          src={imgEsfumer}
          alt={t(lang, 'galv_page.photo_alt_2')}
          width={480} height={320}
          loading="lazy" quality={70}
          class="w-full object-cover rounded fade-up"
          style="height: 260px;"
        />
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-navy py-16 fade-up">
    <div class="max-w-content mx-auto px-4 text-center">
      <h2 class="text-white font-bold mb-4" style="font-size: clamp(1.5rem, 3.5vw, 2.2rem);">
        {t(lang, 'galv_page.cta_final_heading')}
      </h2>
      <p class="text-white/60 text-base mb-8 max-w-lg mx-auto">{t(lang, 'galv_page.cta_final_body')}</p>
      <div class="flex justify-center">
        <WhatsAppButton href={waUrl} variant="inline" label={t(lang, 'galv_page.cta_final_label')} />
      </div>
    </div>
  </section>

</BaseLayout>
