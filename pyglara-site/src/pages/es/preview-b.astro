---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { buildWhatsAppUrl } from '../../utils/i18n';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import imgEsfumer from '../../assets/images/esfumer.jpeg';
const lang = 'es' as const;
---

<BaseLayout title="Preview B — Impact | PYGLARA" description="Preview B" lang={lang} activePage="home">
  <style>
    @keyframes slam-up {
      0%   { opacity: 0; transform: translateY(40px); }
      60%  { opacity: 1; transform: translateY(-4px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes slam-left {
      0%   { opacity: 0; transform: translateX(32px); }
      60%  { opacity: 1; transform: translateX(-3px); }
      100% { opacity: 1; transform: translateX(0); }
    }
    @keyframes copper-bar-grow {
      from { height: 0; }
      to   { height: 100%; }
    }
    @keyframes fade-in {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    .preview-label {
      position: fixed; top: 72px; right: 12px; z-index: 99;
      background: #1B3A5C; color: white; font-size: 11px;
      font-weight: 700; letter-spacing: 0.1em; padding: 4px 10px; border-radius: 4px;
      border: 1px solid #B87333;
    }
    /* Impact-style: system condensed bold */
    .impact-tag {
      font-family: 'Arial Narrow', Arial, sans-serif;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      font-size: 0.65rem;
      opacity: 0;
      animation: fade-in 0.4s ease 0.1s forwards;
    }
    .impact-h1 {
      font-family: 'Arial Black', 'Arial Bold', Arial, sans-serif;
      font-weight: 900;
      text-transform: uppercase;
      line-height: 0.92;
      letter-spacing: -0.01em;
    }
    .line-1 {
      display: block;
      opacity: 0;
      animation: slam-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
    }
    .line-2 {
      display: block;
      color: #B87333;
      opacity: 0;
      animation: slam-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.52s forwards;
    }
    .line-3 {
      display: block;
      opacity: 0;
      animation: slam-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.72s forwards;
    }
    .co-name-impact {
      font-family: 'Arial Narrow', Arial, sans-serif;
      font-weight: 400;
      font-style: normal;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-size: 0.7rem;
      opacity: 0;
      animation: fade-in 0.5s ease 1.1s forwards;
    }
    .sub-impact {
      opacity: 0;
      animation: slam-left 0.5s cubic-bezier(0.22, 1, 0.36, 1) 1.0s forwards;
    }
    .bullet-impact {
      opacity: 0;
    }
    .b1 { animation: fade-in 0.4s ease 1.25s forwards; }
    .b2 { animation: fade-in 0.4s ease 1.45s forwards; }
    .b3 { animation: fade-in 0.4s ease 1.65s forwards; }
    .cta-impact {
      opacity: 0;
      animation: slam-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) 1.85s forwards;
    }
    /* Copper vertical bar — left edge accent */
    .copper-bar {
      position: absolute;
      left: 0; top: 0;
      width: 4px;
      height: 0;
      background: #B87333;
      animation: copper-bar-grow 0.6s ease 0.1s forwards;
    }
  </style>

  <span class="preview-label">OPCIÓN B — Impact</span>

  <section class="relative bg-navy overflow-hidden" style="min-height: 100svh;">
    <Image
      src={imgEsfumer}
      alt="Planta PYGLARA"
      width={1440} height={810} quality={70}
      loading="eager" fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
      style="opacity: 0.38;"
    />
    <!-- Stronger dark overlay for contrast with big bold type -->
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(10,22,40,0.55) 0%, rgba(10,22,40,0.75) 50%, rgba(10,22,40,0.97) 100%);"></div>

    <!-- Left copper bar -->
    <div class="copper-bar"></div>

    <div class="relative z-10 flex flex-col justify-center px-8 md:px-16 py-24 max-w-4xl" style="min-height: 100svh;">

      <!-- Tag -->
      <p class="impact-tag text-copper mb-6">Barquisimeto · Desde 1976</p>

      <!-- BIG headline — 3 slams -->
      <h1 class="impact-h1 text-white mb-6" style="font-size: clamp(2.8rem, 9vw, 7rem);">
        <span class="line-1">Su acero.</span>
        <span class="line-2">Galvanizado.</span>
        <span class="line-3">Garantizado.</span>
      </h1>

      <!-- Company full name — small, under headline -->
      <p class="co-name-impact text-white/50 mb-6 tracking-widest">
        Prensados y Galvanizados de Lara, S.A.
      </p>

      <!-- Sub -->
      <p class="sub-impact text-white/70 text-base md:text-lg leading-relaxed mb-7 max-w-lg">
        La mayor capacidad del occidente venezolano. Cubas hasta 9m. Certificación COVENIN + ASTM en cada entrega.
      </p>

      <!-- Capacity bullets — tight, impact style -->
      <ul class="space-y-2 mb-8">
        <li class="bullet-impact b1 flex items-center gap-3 text-white text-sm font-bold uppercase tracking-wide">
          <span style="width:3px;height:20px;background:#B87333;display:inline-block;flex-shrink:0;"></span>
          300 TM/mes · Cuba hasta 9m
        </li>
        <li class="bullet-impact b2 flex items-center gap-3 text-white text-sm font-bold uppercase tracking-wide">
          <span style="width:3px;height:20px;background:#B87333;display:inline-block;flex-shrink:0;"></span>
          Zinc SHG 99.99% · Equipo Pilling (Alemania)
        </li>
        <li class="bullet-impact b3 flex items-center gap-3 text-white text-sm font-bold uppercase tracking-wide">
          <span style="width:3px;height:20px;background:#B87333;display:inline-block;flex-shrink:0;"></span>
          936 varillas de cobre/día
        </li>
      </ul>

      <div class="cta-impact max-w-xs">
        <WhatsAppButton href={buildWhatsAppUrl(lang, 'galvanizing')} variant="inline" label="Solicitar cotización" />
      </div>
    </div>
  </section>
</BaseLayout>
